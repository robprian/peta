# ---- Database ----
POSTGRES_DB=peta
POSTGRES_USER=peta
POSTGRES_PASSWORD=peta_secret
DATABASE_URL=postgresql://peta:peta_secret@localhost:5432/peta
# Untuk psycopg pool (opsional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
# Batasi agar widget tidak disalahgunakan (opsional, pisahkan dengan koma)
API_KEYS=
RATE_LIMIT_PER_MINUTE=120
CACHE_TTL_SECONDS=86400
# Fallback pencarian kaya (opsional). Contoh: http://localhost:2322
PHOTON_URL=
NOMINATIM_URL=

# ---- Frontend / tile ----
# Dapat dioverride lewat query ?tileUrl= pada widget.
TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
